{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": { "includes": ["**", "!dist", "!public", "!src/api/generated.js"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": { "useImportType": "off" },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Input", "Select"] }
        },
        "useSemanticElements": "off"
      },
      "suspicious": { "noArrayIndexKey": "off" },
      "complexity": { "useLiteralKeys": "off" }
    },
    "domains": { "react": "recommended" }
  },
  "overrides": [
    {
      "includes": ["src/ui/table.jsx"],
      "linter": { "rules": { "a11y": { "useFocusableInteractive": "off" } } }
    }
  ]
}
